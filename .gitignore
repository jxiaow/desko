# Dependencies
node_modules/

# Vite temp files
*.timestamp-*

# Build outputs
dist/
src-tauri/target/
installer/

# IDE
.vscode/
.idea/
.qoder/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Logs
*.log
npm-debug.log*

# Tauri
src-tauri/WixTools/
# tauri-build 根据 capabilities/ 和插件权限自动生成
src-tauri/gen/schemas/
# 服务进程二进制由 sync-fileshare-server.mjs 构建产出
src-tauri/binaries/

# Playwright
test-results/
playwright-report/
blob-report/

# 临时原型、截图和走查产物不入版本库。
design/*

shots/
shots-proto/
docs/design/**/*.png
# 设计决策保留 Markdown；原型和实验产物按需生成。
docs/design/**/*.html
docs/design/**/*.css
docs/design/**/*.json
docs/design/**/*.mjs

# 原型草稿与中间产物，跑完即可弃
.scratch/

# 实跑校验脚本与中间产物，跑完即可弃
tmp/
.tmp/
.taste-skill/

# 走查报告按需生成，不入版本库。
.design-qa/

# 一次性截图/联调脚本，跑完即可弃
scripts/.tmp-*

# 本机运行态与 Python 编译缓存，不入业务仓库
.workbuddy/
__pycache__/
